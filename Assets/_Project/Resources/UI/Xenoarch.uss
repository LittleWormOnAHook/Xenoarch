/* Xenoarch UI. Colours: XenoarchPalette.uss (variables only). Art: Art/Placeholder (Genesis Shift UI frames). */
@import url("XenoarchPalette.uss");
.xa-fill { position: absolute; left: 0; top: 0; right: 0; bottom: 0; }

/* ---------- HUD ---------- */
.xa-crosshair {
    position: absolute; left: 50%; top: 50%; width: 36px; height: 36px; margin-left: -18px; margin-top: -18px;
    background-image: url("/Assets/_Project/Art/Placeholder/Genesis/HUD/Crosshair_Default.png"); -unity-background-image-tint-color: var(--xa-secondary-text);
}
.xa-crosshair--target { background-image: url("/Assets/_Project/Art/Placeholder/Genesis/HUD/Crosshair_Interact.png"); -unity-background-image-tint-color: var(--xa-heading); width: 48px; height: 48px; margin-left: -24px; margin-top: -24px; }
.xa-prompt {
    position: absolute; left: 50%; top: 56%; width: 960px; margin-left: -480px;
    flex-direction: row; justify-content: center; align-items: center;
}
.xa-key {
    min-width: 34px; height: 34px; margin-right: 10px; -unity-text-align: middle-center; -unity-font-style: bold; font-size: 16px;
    color: var(--xa-heading); background-image: url("/Assets/_Project/Art/Placeholder/Genesis/Frames/CutFrame_Glow_3px.png");
    -unity-slice-left: 20; -unity-slice-right: 20; -unity-slice-top: 20; -unity-slice-bottom: 20; -unity-slice-scale: 0.35px;
    -unity-background-image-tint-color: var(--xa-heading);
}
.xa-prompt-text {
    font-size: 18px; color: var(--xa-text); padding: 4px 14px; background-color: var(--xa-graphite);
    white-space: normal; flex-shrink: 1; max-width: 900px;
    border-left-width: 2px; border-left-color: var(--xa-heading);
}
.xa-hold-track {
    position: absolute; left: 50%; top: 61%; width: 220px; height: 6px; margin-left: -110px;
    background-color: var(--xa-secondary-soft);
}
.xa-hold-fill { height: 100%; width: 0; background-color: var(--xa-bar); }
.xa-bottom {
    position: absolute; left: 0; right: 0; bottom: 0; padding: 12px 20px 10px 20px;
    /* no background: the full-width bottom gradient (crimson-tinted after the palette remap) tinted the whole screen
       bottom during play (t106u). Only the slots / panels inside it have backgrounds. */
    background-image: none; background-color: rgba(0, 0, 0, 0);
}
.xa-strip { flex-direction: row; align-items: flex-end; margin-bottom: 6px; }
.xa-slot {
    /* t211u: square slots; names sit above the box in InteractionPromptHud, not inside a taller frame. */
    width: 88px; height: 88px; margin-right: 8px; align-items: center; justify-content: center; padding: 0;
    background-image: url("/Assets/_Project/Art/Placeholder/Genesis/Frames/Slot_Background.png");
    border-width: 1px; border-color: var(--xa-secondary-soft); overflow: hidden;
}
.xa-slot__icon { width: 80px; height: 80px; -unity-background-scale-mode: scale-to-fit; }
.xa-slot__count { position: absolute; right: 4px; top: 2px; font-size: 13px; color: var(--xa-heading); -unity-font-style: bold; }
.xa-slot__name { font-size: 10px; color: var(--xa-text); white-space: nowrap; -unity-text-align: middle-center; width: 88px; overflow: hidden; height: 18px; }
.xa-item-slot { overflow: hidden; }
.xa-hint, .xa-hints { font-size: 13px; color: var(--xa-secondary-text); }

/* ---------- Main menu ---------- */
.xa-menu-root { align-items: center; justify-content: center; background-color: var(--xa-panel-deep); }
.xa-menu-panel {
    width: 520px; padding: 36px 40px; align-items: stretch; background-color: var(--xa-graphite);
    background-image: url("/Assets/_Project/Art/Placeholder/Genesis/Frames/CutFrame_Glow_3px.png");
    -unity-slice-left: 24; -unity-slice-right: 24; -unity-slice-top: 24; -unity-slice-bottom: 24; -unity-slice-scale: 1px;
    -unity-background-image-tint-color: var(--xa-frame);
}
.xa-title { font-size: 54px; -unity-font-style: bold; color: var(--xa-heading); -unity-text-align: middle-center; letter-spacing: 12px; }
.xa-subtitle { font-size: 16px; color: var(--xa-text); -unity-text-align: middle-center; margin-bottom: 28px; }
.xa-button {
    height: 52px; margin: 6px 0; flex-direction: row; align-items: center; padding-left: 18px;
    font-size: 18px; color: var(--xa-text); -unity-text-align: middle-left;
    background-color: var(--xa-panel-dark); border-width: 1px; border-color: var(--xa-secondary-soft); border-radius: 0;
}
.xa-button:hover { border-color: var(--xa-button); color: var(--xa-on-button); background-color: var(--xa-button); }
.xa-button:disabled { opacity: 0.35; }
.xa-glyph { width: 20px; height: 20px; margin-right: 14px; -unity-background-image-tint-color: var(--xa-secondary-text); }
.xa-glyph--play { background-image: url("/Assets/_Project/Art/Placeholder/Genesis/Glyphs/Glyph_Play.png"); }
.xa-glyph--continue { background-image: url("/Assets/_Project/Art/Placeholder/Genesis/Glyphs/Glyph_Refresh.png"); }
.xa-glyph--quit { background-image: url("/Assets/_Project/Art/Placeholder/Genesis/Glyphs/Glyph_Exit.png"); }
.xa-version { font-size: 11px; color: var(--xa-secondary-text); -unity-text-align: middle-center; margin-top: 20px; }

/* ---------- Fade ---------- */
.xa-fade { background-color: var(--xa-panel-deep); opacity: 0; }

/* ---------- Terminals (Phase 1B) ---------- */
.xa-term-root { align-items: center; justify-content: center; background-color: var(--xa-backdrop); }
.xa-term {
    /* Scales with the screen (PanelSettings: scale-with-screen, 1920x1080 reference); centred by .xa-term-root (full-screen); always fits: max 94% x 92% of the screen, contents scroll inside. */
    width: 88%; height: 88%; min-width: 1000px; min-height: 600px; max-width: 94%; max-height: 92%; padding: 22px 26px; background-color: var(--xa-panel-a);
    border-width: 2px; border-color: var(--xa-frame); border-top-width: 3px; border-top-color: var(--xa-heading);
}
.xa-term__header { flex-direction: row; align-items: center; justify-content: space-between; margin-bottom: 12px; }
.xa-term__title { font-size: 26px; -unity-font-style: bold; color: var(--xa-heading); letter-spacing: 4px; }
.xa-term__status { font-size: 15px; color: var(--xa-text); }
.xa-term__body { flex-grow: 1; flex-direction: row; }
.xa-term__col { flex-grow: 1; flex-basis: 0; margin-right: 14px; min-width: 240px; min-height: 0; }
.xa-term__col--wide { flex-grow: 1.6; }
.xa-term__col--list { flex-grow: 1.3; min-width: 320px; }
.xa-term__footer { flex-direction: row; justify-content: space-between; align-items: center; margin-top: 10px; }
.xa-term__hint { font-size: 13px; color: var(--xa-secondary-text); }
.xa-term__h { font-size: 15px; -unity-font-style: bold; color: var(--xa-heading); margin: 8px 0 6px 0; letter-spacing: 2px; }
.xa-term__text { font-size: 15px; color: var(--xa-text); white-space: normal; margin-bottom: 3px; }
.xa-term__dim { font-size: 14px; color: var(--xa-secondary-text); white-space: normal; }
.xa-term__warn { font-size: 15px; color: var(--xa-warn-text); white-space: normal; }
.xa-term__good { font-size: 15px; color: var(--xa-highlight); white-space: normal; }
.xa-term__list { flex-grow: 1; flex-shrink: 1; min-height: 0; background-color: var(--xa-panel-dark); border-width: 1px; border-color: var(--xa-secondary-soft); }
.xa-term__row {
    flex-direction: row; justify-content: space-between; align-items: center; padding: 6px 10px; margin: 1px 0;
    height: auto; min-height: 32px; flex-shrink: 0; white-space: normal;
    background-color: rgba(0, 0, 0, 0); border-width: 0; border-left-width: 3px; border-left-color: rgba(0, 0, 0, 0);
    color: var(--xa-text); font-size: 15px; -unity-text-align: middle-left;
}
.xa-term__row > Label { white-space: normal; flex-shrink: 1; }
.xa-term__row:hover { background-color: var(--xa-secondary-soft); }
.xa-term__row--sel { background-color: var(--xa-highlight-soft); border-left-color: var(--xa-highlight); color: var(--xa-highlight); }
.xa-term__row--here { -unity-font-style: bold; }
.xa-term__row--child { padding-left: 34px; }
.xa-term__row--locked { color: var(--xa-secondary-text); }
.xa-term__btn {
    /* Auto height: long / two-line labels wrap and grow the button instead of clipping. */
    height: auto; min-height: 40px; padding: 8px 12px; flex-shrink: 0; white-space: normal; margin: 6px 0; font-size: 16px; -unity-font-style: bold; color: var(--xa-on-button);
    background-color: var(--xa-button); border-width: 0; border-radius: 2px;
}
.xa-term__btn:hover { background-color: var(--xa-button-hover); }
.xa-term__btn:disabled { background-color: var(--xa-panel-dark); color: var(--xa-secondary-text); }
.xa-term__btn--ghost { background-color: var(--xa-panel-dark); color: var(--xa-text); border-width: 1px; border-color: var(--xa-button); }
.xa-term__btn--ghost:hover { background-color: var(--xa-secondary-soft); }
.xa-term__bar { height: 10px; background-color: var(--xa-panel-deep); margin: 4px 0 8px 0; }
.xa-term__bar-fill { height: 100%; background-color: var(--xa-bar); }
.xa-term__map { flex-grow: 1; background-color: var(--xa-panel-deep); border-width: 1px; border-color: var(--xa-secondary-soft); margin-bottom: 8px; min-height: 260px; overflow: hidden; }
.xa-map-dot { position: absolute; border-radius: 50%; }
.xa-map-label { position: absolute; font-size: 11px; color: var(--xa-text); }
.xa-map-ring { position: absolute; border-width: 1px; border-color: rgba(232, 226, 208, 0.18); border-radius: 50%; }

/* ---------- Surface scanner HUD ---------- */
.xa-scan { position: absolute; right: 28px; top: 28px; width: 360px; padding: 12px 14px; background-color: var(--xa-graphite); border-left-width: 3px; border-left-color: var(--xa-highlight); }
.xa-scan__title { font-size: 15px; -unity-font-style: bold; color: var(--xa-heading); letter-spacing: 2px; }
.xa-scan__text { font-size: 15px; color: var(--xa-text); white-space: normal; }
.xa-scan__pulse { position: absolute; left: 50%; top: 50%; border-width: 2px; border-color: var(--xa-highlight); border-radius: 50%; }

/* Nav terminal system dropdown (t90u) */
.xa-term__dropdown {
    flex-direction: row; justify-content: space-between; align-items: center; margin: 4px 0 6px 0; padding: 6px 10px;
    background-color: var(--xa-panel-dark); border-width: 1px; border-color: var(--xa-frame); border-radius: 2px;
}
.xa-term__dropdown:hover, .xa-term__dropdown--open { border-color: var(--xa-button); }
.xa-term__dropdown-label { font-size: 15px; -unity-font-style: bold; color: var(--xa-heading); letter-spacing: 2px; }
.xa-term__dropdown-arrow { font-size: 12px; color: var(--xa-button); }
.xa-term__dropdown-menu { background-color: var(--xa-panel-dark); border-width: 1px; border-color: var(--xa-frame); padding: 4px; margin-bottom: 6px; flex-shrink: 0; }
.xa-term__dropdown-item { justify-content: space-between; }
.xa-term__dropdown-item:disabled { opacity: 0.55; }

/* ---------- Icons (t155u, approved mockups: Docs/XENOARCH_UI_Icons.md) ----------
   ZEN-22: items = full-colour Xenoarch icon library (Assets/Xenoarch/UI/Icons), untinted, with a corner-accent layer;
   menus, map markers and journal states = Kenney Game Icons (CC0, cropped copies in Art/Icons/UI). */
.xa-icon { -unity-background-scale-mode: scale-to-fit; flex-shrink: 0; }
.xa-icon--target { background-image: url("/Assets/_Project/Art/Icons/UI/target.png"); }
.xa-icon--star { background-image: url("/Assets/_Project/Art/Icons/UI/star.png"); }
.xa-icon--home { background-image: url("/Assets/_Project/Art/Icons/UI/home.png"); }
.xa-icon--arrowDown { background-image: url("/Assets/_Project/Art/Icons/UI/arrowDown.png"); }
.xa-icon--arrowRight { background-image: url("/Assets/_Project/Art/Icons/UI/arrowRight.png"); }
.xa-icon--save { background-image: url("/Assets/_Project/Art/Icons/UI/save.png"); }
.xa-icon--import { background-image: url("/Assets/_Project/Art/Icons/UI/import.png"); }
.xa-icon--gear { background-image: url("/Assets/_Project/Art/Icons/UI/gear.png"); }
.xa-icon--exit { background-image: url("/Assets/_Project/Art/Icons/UI/exit.png"); }
.xa-icon--checkmark { background-image: url("/Assets/_Project/Art/Icons/UI/checkmark.png"); }
.xa-icon--locked { background-image: url("/Assets/_Project/Art/Icons/UI/locked.png"); }
.xa-item-icon { -unity-background-scale-mode: scale-to-fit; }
/* ZEN-22 / t180u / t212u: item icons are the full-colour library art, untinted. Category/rarity show as a separate
   corner-accent layer (XenoarchIcons.ApplyItem): a thin lower-left L, flush to the slot corner, max ~10% alpha,
   tapering thinner up and to the right, soft falloff, stretched along the bottom and left edges.
   Tints stay on the --xa-accent-* classes. Inventory layout (.xa-item-slot) is unchanged. */
.xa-item-accent { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-image: url("/Assets/Xenoarch/UI/Icons/Slot/slot_corner_accent.png"); -unity-background-scale-mode: stretch-to-fill; }
.xa-item-accent--common { -unity-background-image-tint-color: var(--xa-accent-common); }
.xa-item-accent--materials { -unity-background-image-tint-color: var(--xa-accent-materials); }
.xa-item-accent--tech { -unity-background-image-tint-color: var(--xa-accent-tech); }
.xa-item-accent--organic { -unity-background-image-tint-color: var(--xa-accent-organic); }
.xa-item-accent--rare { -unity-background-image-tint-color: var(--xa-accent-rare); }
.xa-item-accent--exceptional { -unity-background-image-tint-color: var(--xa-accent-exceptional); }
/* Library icons used as glyphs (menus, map, journal): full colour, never tinted (beats the state/hover tints). */
.xa-icon--ui-settings { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_settings.png"); }
.xa-icon--ui-complete { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_complete.png"); }
.xa-icon--nav-anomaly { background-image: url("/Assets/Xenoarch/UI/Icons/Navigation/icon_nav_anomaly.png"); }
.xa-icon--nav-base { background-image: url("/Assets/Xenoarch/UI/Icons/Navigation/icon_nav_base_outpost.png"); }
.xa-icon--nav-landing { background-image: url("/Assets/Xenoarch/UI/Icons/Navigation/icon_nav_landing_zone.png"); }
.xa-icon.xa-icon--pack { -unity-background-image-tint-color: rgb(255, 255, 255); }
.xa-button > .xa-glyph.xa-icon--pack, .xa-button:hover > .xa-glyph.xa-icon--pack { -unity-background-image-tint-color: rgb(255, 255, 255); }
.xa-map-icon { position: absolute; width: var(--xa-icon-map); height: var(--xa-icon-map); }
.xa-map-icon__halo { width: var(--xa-icon-map-halo); height: var(--xa-icon-map-halo); -unity-background-image-tint-color: var(--xa-map-halo); }
.xa-map-icon--site { -unity-background-image-tint-color: var(--xa-map-site); }
.xa-map-icon--cache { -unity-background-image-tint-color: var(--xa-map-cache); }
.xa-map-icon--base { -unity-background-image-tint-color: var(--xa-map-base); }
.xa-map-icon--landing { -unity-background-image-tint-color: var(--xa-map-landing); }
.xa-journal-row { flex-direction: row; align-items: center; }
.xa-journal-icon { width: var(--xa-icon-journal); height: var(--xa-icon-journal); margin-right: 8px; margin-bottom: 3px; }
.xa-journal-icon--done { -unity-background-image-tint-color: var(--xa-icon-done); }
.xa-journal-icon--open { -unity-background-image-tint-color: var(--xa-icon-open); }
.xa-journal-icon--locked { -unity-background-image-tint-color: var(--xa-secondary-text); }
/* Menu buttons with a glyph (pause menu): reuses .xa-glyph (20 px, secondary-text tint); dark on hover like the text. */
.xa-button > .xa-glyph { margin-right: 14px; }
.xa-button:hover > .xa-glyph { -unity-background-image-tint-color: var(--xa-on-button); }
.xa-button__label { font-size: 18px; color: var(--xa-text); -unity-text-align: middle-left; padding: 0; margin: 0; }
.xa-button:hover > .xa-button__label { color: var(--xa-on-button); }

/* ---------- Helmet detector (t169u/t170u) ---------- */
.xa-icon--research-unknown { background-image: url("/Assets/Xenoarch/UI/Icons/Research/icon_research_unknown.png"); }
.xa-detector { flex-direction: column; align-items: center; }
.xa-detector__title { font-size: 12px; -unity-font-style: bold; color: var(--xa-heading); letter-spacing: 3px; margin-bottom: 2px; -unity-text-align: upper-center; }
.xa-detector__disc { overflow: hidden; }
.xa-detector__blip { -unity-background-scale-mode: scale-to-fit; }
.xa-detector__signal { font-size: 15px; -unity-font-style: bold; color: var(--xa-highlight); letter-spacing: 1px; }
.xa-detector__dist { font-size: 14px; color: var(--xa-text); margin-top: 2px; }

/* Phase 2 M2: objective tracker HUD */
.xa-obj {
    position: absolute;
    width: 360px;
    padding: 10px 12px 8px 12px;
    background-color: var(--xa-graphite);
    border-left-width: 3px;
    border-left-color: var(--xa-highlight);
}
.xa-obj__title { font-size: 14px; -unity-font-style: bold; color: var(--xa-heading); letter-spacing: 2px; margin-bottom: 4px; }
.xa-obj__side { font-size: 13px; -unity-font-style: bold; color: var(--xa-heading); margin-top: 6px; margin-bottom: 2px; }
.xa-obj__sub { font-size: 11px; -unity-font-style: bold; color: var(--xa-secondary-text); letter-spacing: 2px; margin-top: 8px; margin-bottom: 2px; }
.xa-obj__row { flex-direction: row; align-items: flex-start; margin-bottom: 2px; }
.xa-obj__mark { width: 14px; font-size: 14px; color: var(--xa-highlight); -unity-font-style: bold; flex-shrink: 0; }
.xa-obj__mark--done { width: 14px; font-size: 14px; color: var(--xa-highlight); flex-shrink: 0; }
.xa-obj__line { font-size: 14px; color: var(--xa-text); white-space: normal; flex-shrink: 1; }
.xa-obj__line--done { font-size: 14px; color: var(--xa-secondary-text); white-space: normal; flex-shrink: 1; }
.xa-obj__done { font-size: 13px; color: var(--xa-highlight); margin-bottom: 4px; }
.xa-obj__hint { font-size: 13px; color: var(--xa-secondary-text); white-space: normal; margin-top: 8px; }
.xa-obj__toggle {
    margin-top: 6px; margin-bottom: 0; padding: 2px 8px; height: 22px;
    font-size: 12px; color: var(--xa-secondary-text);
    background-color: rgba(0,0,0,0);
    border-width: 1px; border-color: var(--xa-secondary-soft);
}
.xa-obj__toggle:hover { color: var(--xa-heading); border-color: var(--xa-button); }

.xa-obj__block { margin-bottom: 2px; }
.xa-obj__head { flex-direction: row; align-items: center; margin-bottom: 2px; }
.xa-obj__star { width: 14px; height: 14px; margin-right: 6px; flex-shrink: 0; -unity-background-image-tint-color: var(--xa-heading); }
.xa-obj__star--hidden { opacity: 0; }
.xa-obj__focus { color: var(--xa-heading); }
.xa-obj__idle { color: var(--xa-secondary-text); }
.xa-obj__title.xa-obj__idle, .xa-obj__side.xa-obj__idle { color: var(--xa-secondary-text); }
.xa-obj__title.xa-obj__focus, .xa-obj__side.xa-obj__focus { color: var(--xa-heading); }


/* t243u: inventory context menu (drop / destroy) */
.xa-ctx {
    background-color: var(--xa-panel-deep);
    padding: 6px;
    border-width: 1px;
    border-color: var(--xa-highlight);
    min-width: 260px;
}
.xa-ctx .xa-term__btn { margin-top: 4px; margin-bottom: 0; }

/* ======================================================================================================
   t246u Morpheus-style theme (approved mockups: Docs/Images/UI_Morpheus). Our palette (XenoarchPalette.uss)
   and v3 icons; Morpheus layout language: flat see-through panels with 1 px borders, Jost type, header bars,
   thin % bars, teal selection, key legends, Q/E tab chips, confirm band. Kept last so it overrides the older
   rules above at equal specificity. USS has no text-transform: code upper-cases labels where needed.
   ====================================================================================================== */
:root {
    --xa-m-glass: rgba(40, 9, 14, 0.86);
    --xa-m-glass-2: rgba(78, 18, 26, 0.62);
    --xa-m-tile: rgba(118, 28, 39, 0.30);
    --xa-m-tile-hi: rgba(118, 28, 39, 0.55);
    --xa-m-line: rgba(232, 226, 208, 0.14);
    --xa-m-line-2: rgba(232, 226, 208, 0.28);
    --xa-m-track: rgba(232, 226, 208, 0.12);
    --xa-m-gold: rgb(255, 200, 80);
}
.xa-m-medium, .xa-term__title, .xa-term__h, .xa-obj__title, .xa-m-head, .xa-m-tab, .xa-m-key, .xa-button, .xa-term__btn, .xa-m-badge, .xa-scan__title, .xa-detector__title {
    -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-500-Medium.ttf");
}
.xa-m-light, .xa-title { -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-300-Light.ttf"); }

/* ---- shared building blocks (MUI helpers) ---- */
.xa-m-panel { background-color: var(--xa-m-glass); border-width: 1px; border-color: var(--xa-m-line); }
.xa-m-tile { background-color: var(--xa-m-tile); border-width: 1px; border-color: var(--xa-m-line); }
.xa-m-sel, .xa-m-tile.xa-m-sel { background-color: rgba(104, 223, 214, 0.14); border-color: var(--xa-highlight); }
.xa-m-head {
    flex-direction: row; justify-content: space-between; align-items: center; flex-shrink: 0;
    padding: 7px 12px; margin: 10px 0 6px 0; background-color: var(--xa-m-tile-hi); border-width: 1px; border-color: var(--xa-m-line);
    font-size: 14px; letter-spacing: 2px; color: var(--xa-heading); -unity-font-style: normal;
}
.xa-m-head__title { font-size: 14px; letter-spacing: 2px; color: var(--xa-heading); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-500-Medium.ttf"); }
.xa-m-head__right { font-size: 13px; letter-spacing: 1px; color: var(--xa-secondary-text); }
.xa-m-key {
    min-width: 26px; height: 22px; padding: 0 6px; margin: 0 6px 0 0; -unity-text-align: middle-center;
    font-size: 12px; letter-spacing: 1px; color: var(--xa-text); background-color: rgba(232, 226, 208, 0.08);
    border-width: 1px; border-color: var(--xa-m-line-2); border-radius: 3px; -unity-font-style: normal;
}
.xa-m-key--teal { background-color: var(--xa-button); color: var(--xa-on-button); border-color: var(--xa-button); }
.xa-m-legend { flex-direction: row; justify-content: flex-end; align-items: center; flex-shrink: 0; }
.xa-m-legend__item { flex-direction: row; align-items: center; margin-left: 22px; }
.xa-m-legend__text { font-size: 13px; letter-spacing: 1.5px; color: var(--xa-secondary-text); }
.xa-m-badge {
    font-size: 11px; letter-spacing: 1.5px; padding: 1px 7px; border-width: 1px; border-color: var(--xa-secondary-text);
    color: var(--xa-secondary-text); -unity-text-align: middle-center; flex-shrink: 0; margin-left: 8px;
}
.xa-m-badge--main { color: var(--xa-heading); border-color: var(--xa-heading); }
.xa-m-badge--side, .xa-m-badge--new { color: var(--xa-highlight); border-color: var(--xa-highlight); }
.xa-m-badge--warn { color: var(--xa-warn-text); border-color: var(--xa-warn-text); }
.xa-m-badge--rare { color: var(--xa-accent-rare); border-color: var(--xa-accent-rare); }
.xa-m-bar { height: 6px; flex-grow: 1; background-color: var(--xa-m-track); overflow: hidden; }
.xa-m-bar--thin { height: 4px; }
.xa-m-bar__fill { height: 100%; background-color: var(--xa-bar); }
.xa-m-bar--teal > .xa-m-bar__fill { background-color: var(--xa-highlight); }
.xa-m-barrow { flex-direction: row; align-items: center; flex-shrink: 0; margin: 4px 0; }
.xa-m-barrow__pct { width: 46px; font-size: 13px; color: var(--xa-text); }
.xa-m-barrow__count { min-width: 56px; font-size: 13px; color: var(--xa-secondary-text); -unity-text-align: middle-right; margin-left: 10px; }
.xa-m-dim { font-size: 14px; color: var(--xa-secondary-text); white-space: normal; }
.xa-m-text { font-size: 15px; color: var(--xa-text); white-space: normal; }
.xa-m-card {
    padding: 12px 14px; margin: 4px 0; flex-shrink: 0; background-color: var(--xa-m-tile); border-width: 1px; border-color: var(--xa-m-line);
}
.xa-m-card:hover { border-color: var(--xa-m-line-2); }
.xa-m-card--sel { background-color: rgba(104, 223, 214, 0.12); border-color: var(--xa-highlight); }
.xa-m-card__row { flex-direction: row; align-items: center; }
.xa-m-card__title { font-size: 17px; color: var(--xa-text); flex-grow: 1; flex-shrink: 1; white-space: normal; }
.xa-m-card--sel .xa-m-card__title { color: rgb(255, 255, 255); }
.xa-m-star { width: 18px; height: 18px; margin-right: 10px; flex-shrink: 0; -unity-background-image-tint-color: var(--xa-m-gold); }
.xa-m-star--off { -unity-background-image-tint-color: rgba(232, 226, 208, 0.30); }

/* Tab bar with Q / E chips (journal and other multi-tab windows) */
.xa-m-tabs { flex-direction: row; align-items: center; flex-shrink: 0; border-bottom-width: 1px; border-bottom-color: var(--xa-m-line); margin-bottom: 8px; flex-wrap: wrap; }
.xa-m-tab {
    height: 46px; padding: 0 16px; margin: 0; flex-direction: row; align-items: center; -unity-text-align: middle-center;
    font-size: 15px; letter-spacing: 1.8px; color: var(--xa-secondary-text); background-color: rgba(0, 0, 0, 0);
    border-width: 0; border-bottom-width: 2px; border-bottom-color: rgba(0, 0, 0, 0); border-radius: 0;
}
.xa-m-tab:hover { color: var(--xa-text); background-color: rgba(232, 226, 208, 0.05); }
.xa-m-tab--on { color: var(--xa-text); border-bottom-color: var(--xa-highlight); }
.xa-m-tab__icon { width: 20px; height: 20px; margin-right: 8px; -unity-background-scale-mode: scale-to-fit; }
.xa-m-tabs__spacer { flex-grow: 1; }

/* Confirm band (full-width, Morpheus "Are you sure?") */
.xa-m-band-veil { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(24, 6, 9, 0.55); justify-content: center; }
.xa-m-band {
    padding: 26px 0; align-items: center; background-color: rgba(24, 6, 9, 0.94);
    border-top-width: 1px; border-bottom-width: 1px; border-color: var(--xa-m-line-2);
}
.xa-m-band__title { font-size: 21px; letter-spacing: 1.6px; color: var(--xa-text); -unity-text-align: middle-center; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-500-Medium.ttf"); }
.xa-m-band__text { font-size: 15px; color: var(--xa-secondary-text); margin: 6px 0 14px 0; -unity-text-align: middle-center; white-space: normal; max-width: 900px; }
.xa-m-band__buttons { flex-direction: row; }
.xa-m-band__btn { min-width: 180px; margin: 0 8px; }

/* ---- existing classes restyled ---- */
.xa-button {
    height: 48px; margin: 4px 0; padding-left: 18px; font-size: 16px; letter-spacing: 1.8px;
    background-color: rgba(118, 28, 39, 0.38); border-color: var(--xa-m-line); -unity-font-style: normal;
}
.xa-button:hover, .xa-button.xa-m-sel { background-color: var(--xa-button); border-color: var(--xa-button); color: var(--xa-on-button); }
.xa-button__label { font-size: 16px; letter-spacing: 1.8px; }
.xa-title { -unity-font-style: normal; letter-spacing: 14px; }
.xa-subtitle { letter-spacing: 3px; color: var(--xa-secondary-text); font-size: 14px; }
.xa-menu-panel { background-image: none; background-color: rgba(0, 0, 0, 0); padding: 0; }
.xa-menu-root { background-color: var(--xa-panel-deep); }
.xa-m-menu { position: absolute; left: 0; top: 0; right: 0; bottom: 0; flex-direction: row; padding: 0 120px; align-items: center; }
.xa-m-menu__col { width: 440px; }
.xa-m-menu__side { flex-grow: 1; align-items: flex-end; justify-content: center; }
.xa-m-logo { flex-direction: row; align-items: center; margin-bottom: 46px; }
.xa-m-logo__mark { width: 84px; height: 84px; margin-right: 22px; -unity-background-scale-mode: scale-to-fit; background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_xenoarch_mark.png"); }
.xa-m-logo__name { font-size: 72px; letter-spacing: 22px; color: var(--xa-heading); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-300-Light.ttf"); }
.xa-m-logo__tag { font-size: 14px; letter-spacing: 4px; color: var(--xa-secondary-text); margin-top: 6px; }
.xa-m-menu__title { font-size: 44px; letter-spacing: 14px; color: var(--xa-heading); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-300-Light.ttf"); }
.xa-m-menu__sub { font-size: 15px; letter-spacing: 2px; color: var(--xa-secondary-text); margin: 4px 0 18px 0; padding-bottom: 18px; border-bottom-width: 1px; border-bottom-color: var(--xa-m-line-2); }
.xa-m-menu__note { font-size: 14px; color: var(--xa-secondary-text); white-space: normal; margin-top: 18px; }
.xa-m-menu__version { position: absolute; left: 120px; bottom: 36px; font-size: 12px; letter-spacing: 2px; color: var(--xa-secondary-text); }

.xa-term-root { background-color: rgba(24, 6, 9, 0.72); }
.xa-term {
    background-color: var(--xa-m-glass); border-width: 1px; border-color: var(--xa-m-line); border-top-width: 1px; border-top-color: var(--xa-m-line-2);
    padding: 18px 24px;
}
.xa-term__header { padding-bottom: 10px; border-bottom-width: 1px; border-bottom-color: var(--xa-m-line); }
.xa-term__title { font-size: 20px; letter-spacing: 4px; -unity-font-style: normal; }
.xa-term__status { font-size: 13px; letter-spacing: 1.5px; color: var(--xa-highlight); padding: 2px 8px; border-width: 1px; border-color: rgba(104, 223, 214, 0.5); }
.xa-term__h {
    font-size: 13px; letter-spacing: 2px; -unity-font-style: normal; margin: 10px 0 6px 0; padding: 6px 10px;
    background-color: var(--xa-m-tile-hi); border-width: 1px; border-color: var(--xa-m-line);
}
.xa-term__text { font-size: 15px; }
.xa-term__list { background-color: rgba(24, 6, 9, 0.35); border-color: var(--xa-m-line); }
.xa-term__row { background-color: var(--xa-m-tile); border-width: 1px; border-color: var(--xa-m-line); border-left-width: 1px; margin: 2px 0; }
.xa-term__row:hover { background-color: var(--xa-m-tile-hi); border-color: var(--xa-m-line-2); }
.xa-term__row--sel { background-color: rgba(104, 223, 214, 0.14); border-color: var(--xa-highlight); border-left-color: var(--xa-highlight); color: var(--xa-text); }
.xa-term__btn { -unity-font-style: normal; font-size: 15px; letter-spacing: 1.5px; border-radius: 0; min-height: 42px; }
.xa-term__btn--ghost { background-color: rgba(118, 28, 39, 0.38); border-color: var(--xa-m-line); color: var(--xa-text); }
.xa-term__btn--ghost:hover { background-color: var(--xa-m-tile-hi); border-color: var(--xa-m-line-2); }
.xa-term__bar { height: 6px; background-color: var(--xa-m-track); }
.xa-term__footer { padding-top: 10px; border-top-width: 1px; border-top-color: var(--xa-m-line); }
.xa-term__hint { font-size: 13px; letter-spacing: 1px; }
.xa-term__dropdown { background-color: var(--xa-m-tile); border-color: var(--xa-m-line); border-radius: 0; }

.xa-slot { background-image: none; background-color: rgba(78, 18, 26, 0.72); border-color: var(--xa-m-line); }
.xa-slot__count { -unity-font-style: normal; -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-500-Medium.ttf"); }
.xa-slot__name { font-size: 11px; letter-spacing: 1px; }
.xa-item-slot { border-color: var(--xa-m-line); }

.xa-prompt-text { background-color: rgba(40, 9, 14, 0.78); border-left-color: var(--xa-highlight); letter-spacing: 1px; }
.xa-scan { background-color: rgba(40, 9, 14, 0.78); border-width: 1px; border-color: var(--xa-m-line); border-left-width: 2px; border-left-color: var(--xa-highlight); }
.xa-scan__title { -unity-font-style: normal; letter-spacing: 2px; }

/* Objective tracker (HUD) */
.xa-obj { width: 440px; padding: 14px 16px 12px 16px; background-color: rgba(40, 9, 14, 0.74); border-left-width: 2px; border-left-color: var(--xa-heading); }
.xa-obj__header { flex-direction: row; justify-content: space-between; align-items: center; margin-bottom: 4px; }
.xa-obj__header-title { font-size: 14px; letter-spacing: 2px; color: var(--xa-heading); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-500-Medium.ttf"); }
.xa-obj__block { padding: 8px 0 10px 0; border-top-width: 1px; border-top-color: var(--xa-m-line); margin-bottom: 0; }
.xa-obj__block--first { border-top-width: 0; }
.xa-obj__title { font-size: 16px; letter-spacing: 0.5px; -unity-font-style: normal; margin-bottom: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.xa-obj__side { font-size: 15px; -unity-font-style: normal; margin-top: 0; margin-bottom: 0; flex-grow: 1; flex-shrink: 1; white-space: normal; }
.xa-obj__title.xa-obj__focus, .xa-obj__side.xa-obj__focus { color: rgb(255, 255, 255); }
.xa-obj__title.xa-obj__idle, .xa-obj__side.xa-obj__idle { color: var(--xa-secondary-text); }
.xa-obj__star { width: 18px; height: 18px; margin-right: 10px; -unity-background-image-tint-color: var(--xa-m-gold); }
.xa-obj__star--hidden { opacity: 1; -unity-background-image-tint-color: rgba(232, 226, 208, 0.28); }
.xa-obj__meta { flex-direction: row; justify-content: space-between; margin: 4px 0 4px 28px; }
.xa-obj__meta > Label { font-size: 12px; letter-spacing: 1px; color: var(--xa-secondary-text); }
.xa-obj__barwrap { margin-left: 28px; flex-direction: row; }
.xa-obj__line { font-size: 13px; margin-left: 28px; color: var(--xa-text); }
.xa-obj__hint { font-size: 13px; }
.xa-obj__toggle { border-radius: 0; letter-spacing: 1px; }

/* Toast (notification pipeline) */
.xa-m-toast-stack { position: absolute; left: 0; right: 0; top: 40px; align-items: center; }
.xa-m-toast {
    width: 600px; flex-direction: row; align-items: center; padding: 12px 18px; margin-bottom: 8px;
    background-color: rgba(40, 9, 14, 0.94); border-width: 1px; border-color: var(--xa-m-line); border-left-width: 3px; border-left-color: var(--xa-highlight);
}
.xa-m-toast--old { opacity: 0.55; }
.xa-m-toast__icon { width: 40px; height: 40px; margin-right: 14px; flex-shrink: 0; -unity-background-scale-mode: scale-to-fit; }
.xa-m-toast__kind { font-size: 13px; letter-spacing: 2px; color: var(--xa-highlight); -unity-font-definition: url("/Assets/_Project/Art/Fonts/Jost/Jost-500-Medium.ttf"); }
.xa-m-toast__text { font-size: 17px; color: var(--xa-text); white-space: normal; }

/* t246u: more library icons as glyphs (full colour; names with ui-/nav-/ship-/research- get .xa-icon--pack) */
.xa-icon--ui-missions { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_missions.png"); }
.xa-icon--ui-journal { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_journal.png"); }
.xa-icon--ui-alert { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_alert.png"); }
.xa-icon--ui-warning { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_warning.png"); }
.xa-icon--ui-info { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_info.png"); }
.xa-icon--ui-new-discovery { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_new_discovery.png"); }
.xa-icon--ui-inventory { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_inventory.png"); }
.xa-icon--ui-map { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_map.png"); }
.xa-icon--ui-credits { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_credits.png"); }
.xa-icon--ui-level { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_level.png"); }
.xa-icon--ui-upgrade { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_upgrade.png"); }
.xa-icon--ui-storage { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_storage.png"); }
.xa-icon--ui-skill { background-image: url("/Assets/Xenoarch/UI/Icons/Interface/icon_ui_skill.png"); }
.xa-icon--ship-comms { background-image: url("/Assets/Xenoarch/UI/Icons/Ship/icon_ship_comms.png"); }
.xa-icon--ship-starship { background-image: url("/Assets/Xenoarch/UI/Icons/Ship/icon_ship_starship.png"); }
.xa-icon--ship-shuttle { background-image: url("/Assets/Xenoarch/UI/Icons/Ship/icon_ship_shuttle.png"); }
.xa-icon--nav-rover { background-image: url("/Assets/Xenoarch/UI/Icons/Navigation/icon_nav_rover.png"); }
.xa-icon--research-analyze { background-image: url("/Assets/Xenoarch/UI/Icons/Research/icon_research_analyze.png"); }
.xa-icon--research-archive { background-image: url("/Assets/Xenoarch/UI/Icons/Research/icon_research_archive.png"); }

/* t246u save thumbnails (screenshot when present, dark placeholder for older saves) */
.xa-m-thumb { background-color: rgb(14, 4, 7); border-bottom-width: 1px; border-bottom-color: var(--xa-m-line); background-size: cover; background-position-x: center; background-position-y: center; }

/* t246u tool wheel (hold Tab) */
.xa-wheel-root { position: absolute; left: 0; top: 0; right: 0; bottom: 0; background-color: rgba(12, 3, 5, 0.55); align-items: center; justify-content: center; }
.xa-wheel__title { position: absolute; left: 48px; top: 40px; font-size: 14px; letter-spacing: 3px; color: var(--xa-m-gold); }
.xa-wheel { width: 600px; height: 600px; margin-top: -60px; }
.xa-wheel__graphic { position: absolute; left: 0; top: 0; width: 600px; height: 600px; }
.xa-wheel__slot { position: absolute; width: 64px; height: 64px; }
.xa-wheel__slot--missing { opacity: 0.35; }
.xa-wheel__label { position: absolute; width: 180px; height: 22px; -unity-text-align: middle-center; font-size: 13px; letter-spacing: 2px; color: var(--xa-text); }
.xa-wheel__label--sel { color: var(--xa-highlight); }
.xa-wheel__center { position: absolute; left: 236px; top: 236px; width: 128px; height: 128px; align-items: center; justify-content: center; }
.xa-wheel__action { font-size: 11px; letter-spacing: 2px; color: var(--xa-secondary-text); }
.xa-wheel__name { font-size: 17px; letter-spacing: 2px; color: var(--xa-highlight); -unity-text-align: middle-center; white-space: normal; max-width: 120px; }
.xa-wheel__info { position: absolute; bottom: 56px; width: 640px; flex-direction: row; align-items: center; padding: 12px 16px; }
.xa-wheel__info-icon { width: 56px; height: 56px; margin-right: 16px; border-width: 1px; border-color: var(--xa-highlight); background-color: var(--xa-m-tile); padding: 4px; }
.xa-wheel__picker { position: absolute; right: 60px; top: 120px; width: 420px; padding: 16px 18px; }
.xa-wheel__pick { flex-direction: row; align-items: center; margin: 0 0 4px 0; padding: 6px 10px; border-radius: 0; }
.xa-wheel__pick-icon { width: 36px; height: 36px; margin-right: 12px; }
.xa-wheel__legend { position: absolute; right: 48px; bottom: 30px; }
