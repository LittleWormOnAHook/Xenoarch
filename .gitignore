# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/[Mm]emoryCaptures/
/[Rr]ecordings/
/ProfilerCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# IDE / tooling
.vs/
.vscode/
.idea/
.cursor/
*.csproj
*.unityproj
*.sln
*.slnx
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity Version Control workspace metadata (project uses Git)
.plastic/
ignore.conf

# Crash / build artefacts
sysinfo.txt
crashlytics-buildid.txt
*.apk
*.aab
*.unitypackage
*.app
mono_crash.*

# OS
.DS_Store
Thumbs.db
Desktop.ini

# Vendor packages are NOT committed by default (licence + size). Add an explicit
# exception per package only after confirming Dark Matter Interactive's licence covers it.
/[Aa]ssets/_Vendor/
/[Aa]ssets/_Vendor.meta

# Vendor / third-party roots: imported locally, NOT in git (mirrors ASH)
# Vendor: Creepy Cat 3D Scifi Kit Vol 3
/Assets/_Creepy_Cat/
/Assets/_Creepy_Cat.meta
# Vendor: Digger PRO
/Assets/Digger/
/Assets/Digger.meta
# Vendor: FPS Starter Pack
/Assets/FPS_Starter_Pack/
/Assets/FPS_Starter_Pack.meta

# Vendor: ruins packs and stray models (Anthony's RUINS drop folder)
/Assets/RUINS/
/Assets/RUINS.meta
# Vendor: Pro Sound Collection (Unreal .uasset pack and any converted audio; do not commit)
/Assets/Pro Sound Collection/
/Assets/Pro Sound Collection.meta
/Assets/ProSoundCollection/
/Assets/ProSoundCollection.meta
# Vendor: Ancient Empires Music Pack
/Assets/AncientEmpiresMusicPack/
/Assets/AncientEmpiresMusicPack.meta
/Assets/Pro Sound Collection v4.26/
/Assets/Pro Sound Collection v4.26.meta

# UE4 converter / UModel: vendor-derived output and the extraction tool are NEVER committed
/Assets/_Vendor/Converted/
/Assets/[Rr][Uu][Ii][Nn][Ss]/
/Assets/[Rr][Uu][Ii][Nn][Ss].meta
/Assets/_Project/[Rr]uins/
/Assets/_Project/[Rr]uins.meta
/Assets/Pro Sound Collection/
/Assets/Pro Sound Collection.meta
/Assets/_Project/UE4ConvTest/
/Tools/UModel/
/UE_Packs/

# Pro Sound Collection (vendor .uasset pack + the audio extracted from it): never committed
/Assets/Pro Sound Collection*/
/Assets/Pro Sound Collection*.meta
